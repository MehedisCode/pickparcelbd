# Template only. Configure on the cPanel backend; do not replace Ubuntu's .env.
# Staging hostnames configured; set secrets privately before activation.
APP_NAME=PickParcelBD
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://staging-api.pickparcelbd.com
FRONTEND_URL=https://staging.pickparcelbd.com
APP_LOCALE=bn
APP_FALLBACK_LOCALE=en
LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mariadb
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=kinboame_pp_staging
# Runtime account and scoped cPanel privileges verified; configure its password privately.
DB_USERNAME=kinboame_pp_stg_app
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=database
SESSION_LIFETIME=43200
SESSION_COOKIE=pickparcel_staging_session
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=
SANCTUM_STATEFUL_DOMAINS=staging.pickparcelbd.com,staging-api.pickparcelbd.com
CACHE_STORE=database
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=300
PREVIEW_LOGIN=true

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://staging.pickparcelbd.com/auth/google/callback
FIREBASE_CREDENTIALS=
SUPPORT_EMAIL=support@example.com
SUPPORT_PHONE=01XXXXXXXXX
GEOCODING_ENABLED=false
GEOCODING_URL=https://nominatim.openstreetmap.org
GEOCODING_USER_AGENT="PickParcelBD/1.0 (+https://pickparcelbd.com)"
